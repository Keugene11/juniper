# Required for the AI stages (ICP inference, lead scoring, message generation).
# If unset, the SDK also picks up an `ant auth login` profile automatically.
ANTHROPIC_API_KEY=

# Optional real enrichment providers. Without these the waterfall falls back to
# pattern inference + live MX verification, which is free and needs no account.
HUNTER_API_KEY=
APOLLO_API_KEY=

# Where the SQLite file lives. Defaults to ./data/juniper.db
JUNIPER_DB_PATH=

# Scheduled runs. Vercel Cron sends this as `Authorization: Bearer <secret>`;
# with it unset, /api/cron/run refuses rather than running unauthenticated.
CRON_SECRET=
# Unattended runs are deliberately stingier than the button, since nobody is
# watching the spend. Defaults: 70 and 3.
JUNIPER_CRON_THRESHOLD=
JUNIPER_CRON_MAX_OUTREACH=

# --- Signal sources that need credentials -----------------------------------
# Reddit: register a "script" app at https://www.reddit.com/prefs/apps.
# The free tier is NON-COMMERCIAL ONLY (personal projects and research).
# Commercial use needs Reddit's written approval and a paid agreement — if you
# are selling this, leave these unset.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit asks clients to identify themselves; include a contact.
REDDIT_USER_AGENT=

# Crunchbase: funding rounds. Paid — their free tier was withdrawn.
CRUNCHBASE_API_KEY=
CRUNCHBASE_WINDOW_DAYS=

# Unipile: LinkedIn engagement through an account you connect. Automated access
# is against the LinkedIn User Agreement and the restriction risk lands on your
# own account. The DSN includes a port, e.g. https://api1.unipile.com:13111
UNIPILE_DSN=
UNIPILE_API_KEY=

# --- Outbound destinations ---------------------------------------------------
# Every configured destination receives every pushed lead.
SLACK_WEBHOOK_URL=
JUNIPER_WEBHOOK_URL=
JUNIPER_WEBHOOK_SECRET=
HUBSPOT_ACCESS_TOKEN=
PIPEDRIVE_API_TOKEN=
# Push during a pipeline run rather than only from the button. Off by default:
# a push writes into systems other people are looking at.
JUNIPER_AUTO_PUSH=

# Days before the same contact may be sequenced again. Counts a sequence we
# wrote or an outcome you marked by hand. Default 30.
JUNIPER_CONTACT_COOLDOWN_DAYS=
